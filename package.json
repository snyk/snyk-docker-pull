{
  "name": "@snyk/snyk-docker-pull",
  "description": "CLI-less docker pull",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "jest --verbose --runInBand",
    "lint": "prettier --check '**/*.ts' && eslint 'src/**/*.ts' && (cd test && eslint '**/*.ts')",
    "format": "prettier --loglevel warn --write '**/*.ts'",
    "prepare": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/snyk/snyk-docker-pull.git"
  },
  "author": "snyk.io",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=12"
  },
  "devDependencies": {
    "@types/jest": "^26.0.21",
    "@types/node": "^16.11.6",
    "@types/tar-fs": "^2.0.4",
    "@typescript-eslint/eslint-plugin": "^4.28.5",
    "@typescript-eslint/parser": "^4.28.5",
    "eslint": "^7.22.0",
    "eslint-config-prettier": "^7.2.0",
    "eslint-plugin-jest": "^24.4.0",
    "glob": "^7.1.6",
    "jest": "^26.6.3",
    "mkdir-recursive": "^0.4.0",
    "prettier": "^2.7.1",
    "ts-jest": "^26.5.4",
    "ts-node": "^10.4.0",
    "typescript": "^4.7.4",
    "semantic-release": "^19.0.5"
  },
  "dependencies": {
    "@snyk/docker-registry-v2-client": "^3.0.0",
    "child-process": "^1.0.2",
    "tar-fs": "^3.0.9"
  },
  "release": {
    "branches": [
      "main"
    ]
  }
}
