{
  "name": "snyk-docker-pull",
  "description": "CLI-less docker pull",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest --verbose --runInBand",
    "lint": "prettier --check '**/*.ts' && tslint --format stylish '**/*.ts' --exclude 'node_modules/**'",
    "format": "prettier --loglevel warn --write '**/*.ts' && tslint --fix --format stylish '**/*.ts' --exclude 'node_modules/**'",
    "prepare": "npm run build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/snyk/docker-pull.git"
  },
  "author": "snyk.io",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/jest": "^24.0.15",
    "@types/node": "^11.13.18",
    "@types/tmp": "^0.1.0",
    "jest": "^24.8.0",
    "prettier": "^1.18.2",
    "ts-jest": "^24.0.2",
    "ts-node": "^8.3.0",
    "tslint": "^5.18.0",
    "tslint-config-prettier": "^1.18.0",
    "typescript": "^3.5.3"
  },
  "dependencies": {
    "child-process": "^1.0.2",
    "docker-registry-v2-client": "^1.7.2",
    "request": "^2.88.0",
    "request-promise-native": "^1.0.7",
    "tmp": "^0.1.0"
  }
}
